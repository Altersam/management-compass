{
  "name": "management-compass",
  "version": "3.6.0",
  "private": true,
  "type": "module",
  "description": "Альманах менеджера: теория, игры, рабочие ситуации, техники и личный дневник",
  "repository": {
    "type": "git",
    "url": "https://github.com/Altersam/management-compass.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/serve.cjs --open",
    "serve": "node scripts/serve.cjs",
    "build": "node scripts/build.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "playwright test",
    "lint:content": "node scripts/lint-content.cjs",
    "test:a11y": "playwright test --config playwright.a11y.config.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.64.0"
  }
}
